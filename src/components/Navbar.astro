---
import { MobileNav } from './MobileNav';
---

<header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
	<div class="container mx-auto flex h-16 items-center justify-between px-4">
		<div class="flex items-center gap-6 md:gap-10">
			<a href="/" class="flex items-center space-x-2">
				<span class="inline-block font-bold text-xl">HJ Blog</span>
			</a>
			<nav class="hidden gap-6 md:flex">
				<a href="/" class="flex items-center text-sm font-medium text-muted-foreground hover:text-foreground">
					Home
				</a>
				<a href="/blog" class="flex items-center text-sm font-medium text-muted-foreground hover:text-foreground">
					Blog
				</a>
			</nav>
		</div>
		<div class="flex flex-1 items-center justify-end space-x-4">
			<nav class="flex items-center space-x-1">
				<MobileNav client:load />
			</nav>
		</div>
	</div>
</header>

