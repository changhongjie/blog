---
import { Github, Linkedin } from 'lucide-react';
---

<footer class="border-t py-6">
	<div class="container mx-auto flex flex-col items-center justify-between gap-4 md:h-24 md:flex-row px-4">
		<p class="text-center text-sm leading-loose text-muted-foreground md:text-left">
			Built with Astro, Tailwind, and Shadcn.
		</p>
		<div class="flex items-center gap-4">
			<a href="https://github.com/changhongjie" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors">
				<Github className="h-5 w-5" />
				<span class="sr-only">GitHub</span>
			</a>
			<a href="https://www.linkedin.com/in/hongjie-chang" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors">
				<Linkedin className="h-5 w-5" />
				<span class="sr-only">LinkedIn</span>
			</a>
			<a href="https://x.com/hongjielalalala" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors">
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
				<span class="sr-only">X</span>
			</a>
		</div>
	</div>
</footer>

